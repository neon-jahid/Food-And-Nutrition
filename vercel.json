      "source": "/food/:id",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "bn"
        }
      ],
      "destination": "/bn/foods/:id",
      "permanent": true
    },
    {
      "source": "/foods",
      "has": [
