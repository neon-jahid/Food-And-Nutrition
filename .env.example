# Copy this file to .env and fill in before building for production.
# Any editor is fine (UTF-8 with or without BOM, Windows or Unix line endings).

# Public URL of the site — domain only, https, no trailing path.
# Used for canonical URLs, hreflang, Open Graph tags, sitemap.xml and robots.txt.
# REQUIRED for a real deployment. Example: VITE_SITE_URL=https://food-and-nutrition.com
VITE_SITE_URL=

# Optional: shown on the /contact page as a mailto link. Example: hello@food-and-nutrition.com
VITE_CONTACT_EMAIL=
