# Copy to .env and fill in before building for production.

# Public URL of the site (no trailing slash). Used for canonical URLs, hreflang,
# Open Graph tags, sitemap.xml and robots.txt. REQUIRED for a real deployment.
VITE_SITE_URL=https://your-domain.com

# Optional: shown on the /contact page as a mailto link.
VITE_CONTACT_EMAIL=
