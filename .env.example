# Copy this file to .env and fill in before building for production.
# Any editor is fine (UTF-8 with or without BOM, Windows or Unix line endings).
#
# On Vercel / Netlify: don't upload .env — add the same keys in the host's dashboard
# (Vercel → Project → Settings → Environment Variables), then redeploy.

# Public URL of the site — https://domain only, no trailing path.
# Used for canonical URLs, hreflang, Open Graph tags, sitemap.xml and robots.txt.
# Small mistakes are fixed automatically (missing https://, a trailing path, quotes) with a warning.
# On Vercel, if this is empty, the project's production domain (*.vercel.app) is used.
# Example: VITE_SITE_URL=https://food-and-nutrition.com
VITE_SITE_URL=

# Optional: shown on the /contact page as a mailto link. Example: hello@food-and-nutrition.com
# An invalid address is ignored (with a build warning) instead of failing the build.
VITE_CONTACT_EMAIL=
